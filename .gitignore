# Secrets — never commit real environment files
.env
.env.*
!.env.example

# Dependencies
vendor/
node_modules/

# Build output / caches
.nuxt/
.output/
.data/
.cache/
dist/

# Logs
*.log
npm-debug.log*

# Personal Claude Code settings (shared settings.json may be committed)
.claude/settings.local.json

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
